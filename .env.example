# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase project → Settings → API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (for admin operations — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database ─────────────────────────────────────────────────────────────────
# Found in: Supabase project → Settings → Database → Connection string
# Use the "Transaction" URL for the pooled connection (for Vercel serverless)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xx-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Use the "Session" URL for Prisma migrations (direct connection)
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-xx-east-1.pooler.supabase.com:5432/postgres

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Found in: Google Cloud Console → APIs & Services → Credentials
# Redirect URI to add: https://your-project.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Resend ───────────────────────────────────────────────────────────────────
# Found in: resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=TutorTimeCard <noreply@yourdomain.com>
